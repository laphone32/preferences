#!/usr/bin/env bash
# File: shortcut/bashrc

sourceShare bash override.sh 2>/dev/null || source "$PREFERENCES_DIR/bash/share/bash/override.sh"

# In Debian/Ubuntu, keyd is installed as keyd.rvaiya to avoid naming conflicts.
# This wraps it back to `keyd` using the custom framework override function.
if ! command -v keyd &> /dev/null && command -v keyd.rvaiya &> /dev/null; then
    replace 'keyd' '' 'keyd.rvaiya'
fi
