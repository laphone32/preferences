/* Allow members of keyd group to start/stop/restart keyd.service without authentication */
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "keyd.service" &&
        (subject.isInGroup("keyd") || subject.isInGroup("sudo") || subject.isInGroup("wheel"))) {
        return polkit.Result.YES;
    }
});
