#!/usr/bin/env bash
# File: agy/bashrc

sourceShare bash override.sh 2>/dev/null || source "$PREFERENCES_DIR/bash/share/bash/override.sh"
source "$PREFERENCES_DIR/agy/common.sh"

replace 'agy' "
    if ! command -v sbx &> /dev/null; then
        echo \"❌ Error: 'sbx' command not found. Please install Docker Sandboxes (sbx).\" >&2
        return 1
    fi

    # Check if current directory or any passed workspace argument is \$HOME
    local cwd_real=\"\$(pwd -P 2>/dev/null || pwd)\"
    local home_real=\"\$(cd \"\$HOME\" 2>/dev/null && pwd -P || echo \"\$HOME\")\"

    if [ \"\$cwd_real\" = \"\$home_real\" ] || [ \"\$cwd_real\" = \"\$HOME\" ]; then
        echo \"❌ Error: Cannot run 'agy' in \$HOME directory (\$HOME). Please run it inside a project workspace.\" >&2
        return 1
    fi

    for arg in \"\$@\"; do
        if [ \"\$arg\" = \"\$HOME\" ] || [ \"\$arg\" = \"~\" ]; then
            echo \"❌ Error: Cannot mount \$HOME directory (\$HOME) as a workspace.\" >&2
            return 1
        fi
        if [ -d \"\$arg\" ]; then
            local arg_real=\"\$(cd \"\$arg\" 2>/dev/null && pwd -P || true)\"
            if [ \"\$arg_real\" = \"\$home_real\" ] || [ \"\$arg_real\" = \"\$HOME\" ]; then
                echo \"❌ Error: Cannot mount \$HOME directory (\$HOME) as a workspace.\" >&2
                return 1
            fi
        fi
    done
" 'sbx run --kit "${PREFERENCES_AGY_SBX_KIT}" agy . --'
