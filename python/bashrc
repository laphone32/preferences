#!/usr/bin/env bash

sourceShare bash override.sh 2>/dev/null || true
sourceShare bash utils.sh 2>/dev/null || true

source "$PREFERENCES_DIR/python/common.sh"
sourceShare python pvenv.sh

replace 'python' '' 'python3'

wrapParameterBind 'pylint' "--rcfile $PREFERENCES_WORKSPACE_PYTHON_PYLINTRC"
export PYTHONPATH="${PREFERENCES_WORKSPACE:-$PREFERENCES_DIR/.workspace}/share/python:$PREFERENCES_DIR${PYTHONPATH:+:$PYTHONPATH}"
