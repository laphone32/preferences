#!/usr/bin/env bash

if [ -z "$PREFERENCES_DIR" ]; then
    export PREFERENCES_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"
fi

source "$PREFERENCES_DIR/bootstrap.sh" 2>/dev/null || true

COMPILED_LOADER="${PREFERENCES_WORKSPACE:-$PREFERENCES_DIR/.workspace}/bash/compiled_bashrc.sh"
if [ -f "$COMPILED_LOADER" ]; then
    source "$COMPILED_LOADER"
else
    forEachModuleFile 'bashrc' 'source'
fi
