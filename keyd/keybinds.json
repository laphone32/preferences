{
  "Super + C": {
    "description": "Copy",
    "global": "Ctrl + Insert",
    "apps": {
      "*kitty*": "Ctrl + Shift + C",
      "*chrome*": "Ctrl + C"
    }
  },
  "Super + V": {
    "description": "Paste",
